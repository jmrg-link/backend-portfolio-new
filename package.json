{
  "name": "backend-portfolio-new",
  "version": "1.0.0",
  "description": "Backend del portfolio — Fastify 5 (HTTP/2), Emmett event sourcing, hexagonal + Screaming Architecture, Winston+Loki, Zod.",
  "type": "module",
  "main": "dist/main.js",
  "license": "ISC",
  "engines": {
    "node": ">=24 <25"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.9.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "vite build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1079.0",
    "@aws-sdk/s3-request-presigner": "3.1079.0",
    "@clerk/fastify": "3.1.45",
    "@event-driven-io/emmett": "0.42.3",
    "@fastify/compress": "9.0.0",
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/swagger": "9.7.0",
    "@fastify/swagger-ui": "6.0.0",
    "chalk": "5.6.2",
    "dayjs": "1.11.21",
    "dotenv": "17.4.2",
    "fastify": "5.9.0",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "5.11.1",
    "jose": "6.2.3",
    "mailtrap": "4.6.1",
    "mongoose": "9.7.3",
    "nanoid": "5.1.16",
    "reflect-metadata": "0.2.2",
    "sharp": "0.35.3",
    "slugify": "1.6.9",
    "winston": "3.19.0",
    "winston-loki": "6.1.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.0",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "prettier": "3.9.4",
    "rimraf": "6.1.3",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vite": "8.1.3",
    "vitest": "4.1.9"
  }
}
