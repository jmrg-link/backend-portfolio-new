# ---------------------------------------------------------------------------
# Plantilla de entorno. Copia a `.env.local` (el loader usa `.env.${NODE_ENV}`)
# y rellena los valores. NUNCA commitees el `.env` / `.env.local` reales.
# ---------------------------------------------------------------------------

########################
#        SERVER        #
########################
PORT=3000
HOST=0.0.0.0
NODE_ENV=local
API_PREFIX=/api
API_VERSION=v1
# CSV de orígenes permitidos para CORS (vacío = ninguno)
CORS_ORIGINS=http://localhost:3000
# TLS del servidor (PEM). Con ambos: HTTPS+HTTP/2 nativo (ALPN h2/http1.1).
# Vacíos: HTTP/2 cleartext (h2c) para local o detrás de Traefik.
TLS_CERT_PATH=
TLS_KEY_PATH=

########################
#        MONGO         #
########################
# Requerido. Replica set (rs0) para transacciones / event sourcing.
MONGODB_URI=mongodb://user:password@localhost:27017/imagedb?authSource=admin&replicaSet=rs0

########################
#        CLERK         #
########################
# Auth vía @clerk/fastify. Verificación de sesión con JWKS (RS256).
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
CLERK_JWKS_URL=https://clerk.your-domain.dev/.well-known/jwks.json
CLERK_BACKEND_API_URL=https://api.clerk.com
CLERK_FRONTEND_API_URL=https://clerk.your-domain.dev
# Clave pública PEM (RS256) — opcional, alternativa/complemento al JWKS
CLERK_PUBLIC_KEY=

########################
#          S3          #
########################
AWS_REGION=eu-west-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Endpoint custom (LocalStack / MinIO); en AWS real dejar vacío
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

########################
#         LOKI         #
########################
# Endpoint de ingesta de Grafana Loki (opcional; solo staging/prod)
LOKI_HOST=
